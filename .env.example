# Every variable the service reads, with its default. The defaults match
# docker-compose.yml, so a fresh clone needs no .env file.

NODE_ENV=production
PORT=3000
# A new UUID per boot when unset.
INSTANCE_ID=

DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
DATABASE_OWNER_URL=postgres://wagering_owner:wagering_owner@localhost:5432/wagering
DATABASE_POOL_MAX=21
DB_LOCK_TIMEOUT_MS=2000

# MiniStack accepts any credentials.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Inserted before .fifo in the three queue names.
SQS_QUEUE_SUFFIX=
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_BACKOFF_BASE_MS=2000
SQS_BACKOFF_CAP_MS=60000

HTTP_BULKHEAD_SIZE=11
HTTP_BULKHEAD_QUEUE=50

# Role flags: which parts of the service this instance runs.
HTTP_ENABLED=true
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
REFERENCE_WORKER_ENABLED=true

REFERENCE_TTL_SECONDS=86400
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# Test only (requires NODE_ENV=test), comma-separated:
# crash-after-commit, crash-after-send, unexpected-on-wallet:<walletId>
FAULT_INJECTION=
