{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "eslint/no-loss-of-precision": "error",
    "typescript/await-thenable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/switch-exhaustiveness-check": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": [
        "src/domain/**/*.ts"
      ],
      "excludeFiles": [
        "**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/**",
                  "**/contracts/**",
                  "**/infrastructure/**",
                  "**/interface/**",
                  "**/bootstrap/**"
                ],
                "message": "domain imports only domain"
              },
              {
                "group": [
                  "@*/*",
                  "zod",
                  "prom-client",
                  "node:*",
                  "!node:crypto"
                ],
                "message": "domain imports no packages except node:crypto"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/application/**/*.ts"
      ],
      "excludeFiles": [
        "**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/contracts/**",
                  "**/infrastructure/**",
                  "**/interface/**",
                  "**/bootstrap/**"
                ],
                "message": "application imports only domain"
              },
              {
                "group": [
                  "@*/*",
                  "zod",
                  "prom-client",
                  "node:*",
                  "!node:crypto"
                ],
                "message": "application imports no packages except node:crypto"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/contracts/**/*.ts"
      ],
      "excludeFiles": [
        "**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/domain/**",
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/interface/**",
                  "**/bootstrap/**"
                ],
                "message": "contracts import only zod"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/interface/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/infrastructure/**",
                  "**/bootstrap/**"
                ],
                "message": "interface reaches infrastructure through ports"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/infrastructure/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/interface/**",
                  "**/bootstrap/**"
                ],
                "message": "infrastructure does not import interface"
              }
            ]
          }
        ]
      }
    }
  ]
}
