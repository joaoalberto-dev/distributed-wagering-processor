{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start:dev": "bun --watch src/bootstrap/main.ts",
    "start:prod": "bun dist/bootstrap/main.js",
    "setup": "bun scripts/setup.ts",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "dlq:redrive": "bun scripts/redrive-dlq.ts",
    "demo": "bun scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src/ test/ migrations/ scripts/",
    "format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "bun test ./src/",
    "test:watch": "bun --watch test ./src/",
    "test:cov": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov ./src/",
    "test:debug": "bun --inspect-brk test ./src/",
    "test:integration": "nest build && bun test --timeout 60000 ./test/integration/",
    "test:concurrency": "nest build && bun test --timeout 180000 ./test/concurrency/",
    "test:all": "bun run test && bun run test:integration && bun run test:concurrency",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1167.0",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.8",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/terminus": "12.1.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.2"
  }
}
